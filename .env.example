# ----------------------------------------------------------------------
# shaft-design-agent config
# ----------------------------------------------------------------------
# Default: Qwen3.6-27B via Groq (stable tool calling; some smaller Llama
# models fail to format calls with more complex arguments — see the
# provider examples below to switch).
# Switch providers by changing LLM_BASE_URL + LLM_AGENT_MODEL — the
# matching key below is selected automatically (see make_client), so you
# never move keys around.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_AGENT_MODEL=qwen/qwen3.6-27b

# --- Other provider examples (change LLM_BASE_URL; the matching key is auto-selected) ---
# OpenAI:      unset LLM_BASE_URL, LLM_AGENT_MODEL=gpt-5-mini
# Together:    LLM_BASE_URL=https://api.together.xyz/v1
# DeepSeek:    LLM_BASE_URL=https://api.deepseek.com/v1
# Anthropic:   LLM_BASE_URL=https://api.anthropic.com/v1/ LLM_AGENT_MODEL=claude-sonnet-4-6
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1 (model slugs are provider/model, e.g. deepseek/deepseek-v4-flash; see openrouter.ai/models)

# --- Provider keys: fill in the one(s) you use. make_client() picks by provider. ---
# OPENAI_API_KEY also covers Together / DeepSeek (OpenAI-compatible endpoints).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
MANUS_API_KEY=
